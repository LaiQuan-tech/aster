# 亞斯特系統環境變數範本
# 複製為 repo 根目錄的 .env（已在 .gitignore，不會被 commit）
#   cp .env.example .env
# API 的整合測試會由 vitest setupFile 載入這份 .env。

# ---------------------------------------------------------------- 必要 ----
# Supabase 專案設定 → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role 可繞過 RLS，只放在伺服器端，切勿放進 web 或 commit 進 repo
SUPABASE_SERVICE_ROLE_KEY=

# Postgres 連線字串（drizzle migrate 用）→ Project Settings → Database
DATABASE_URL=

# 前端用（Next.js 會編進 bundle，只能放公開值）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000

# 平台管理員（以逗號分隔的 email，可進後台最高權限）
PLATFORM_ADMIN_EMAILS=

# ------------------------------------------------------------ 選用功能 ----
# 背景工作（BullMQ）；本機無 redis 可留空，worker 不啟動不影響 web/api
REDIS_URL=
ENABLE_WORKER_SCHEDULERS=false
# worker 打 API 內部端點用的位址（線上 = https://aster-hr-api.vercel.app）；未設則退回 API_URL
API_INTERNAL_URL=
ENABLE_INTERNAL_JOBS=false
INTERNAL_JOB_TOKEN=

# 通知寄送 / 帳號邀請信 / 重設密碼信 / 薪資條 Email（Resend）
# RESEND_API_KEY 未設 → 邀請信與重設密碼信改走 dryRun：不寄信，把連結回給 HR 手動轉交；
#                       薪資條寄送端點回 409 mail_not_configured
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
LINE_CHANNEL_ACCESS_TOKEN=
# 通知預設投遞管道（逗號分隔，如 email）。未設＝只產生站內通知，不外送。
# 員工可在 ESS 逐管道關掉（user_preferences 的 notify.channels.v1），明示關閉的不會送。
NOTIFICATION_DEFAULT_CHANNELS=
# 邀請信／重設密碼信裡的連結要指向的前台網址（線上 = https://aster-system.vercel.app，未設即用此預設）
WEB_URL=http://localhost:3000

# AI 功能
GEMINI_API_KEY=
# 生成模型預設 gemini-flash-latest（浮動別名；釘死版本會像 gemini-2.0-flash 那樣被下架）。要固定就填版本。
GEMINI_MODEL=
# 向量模型預設 gemini-embedding-001（768 維）。換模型要同時重建知識庫索引（維度寫死在 knowledge_chunks）。
GEMINI_EMBED_MODEL=

# ---------------------------------------------------------------- 其他 ----
PORT=4000
WEB_ORIGINS=http://localhost:3000
LOG_LEVEL=info
