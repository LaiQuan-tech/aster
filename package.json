{
  "name": "hr-saas",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm -w @hr/db run generate",
    "db:migrate": "npm -w @hr/db run migrate",
    "db:apply": "npm -w @hr/db run apply-sql --",
    "db:replay": "npm -w @hr/db run replay --"
  },
  "devDependencies": {
    "@types/node": "^22",
    "turbo": "^2",
    "typescript": "^5.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.9.0",
  "overrides": {
    "postcss": "^8.5.28",
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.0"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
